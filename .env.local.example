# Supabase (wajib untuk aplikasi)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk skrip lokal `seed`/`backfill`; jangan pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Apps Script Web App (server-only, tanpa awalan NEXT_PUBLIC_)
GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GOOGLE_SHEETS_API_SECRET=
# Dipakai backfill sebagai pengaman agar URL di atas tidak menunjuk workbook lama.
GOOGLE_SHEETS_SPREADSHEET_ID=14rUshtHE2lF9QM0SlCB4djMfuzlLt3XK7zhcBi5VxSY

# Sumber Master Data wajib eksplisit: "sheets" atau "postgres".
# - sheets  : identitas material dibaca/ditulis langsung ke Google Sheets.
# - postgres: tabel master_items jadi sumber utama; Sheets ditulis sebagai mirror.
# Nyalakan "postgres" hanya SETELAH menjalankan migrasi master-items + backfill.
MASTER_SOURCE=sheets
# Sumber stok: "sheets" (default) atau "postgres".
# - sheets  : stok dibaca/ditulis lewat Google Sheets (perilaku lama).
# - postgres: stok berjalan dari jurnal Postgres (kilat); Sheets jadi mirror.
# Nyalakan "postgres" hanya SETELAH menjalankan migrasi stock-ledger + backfill.
STOCK_SOURCE=sheets

# Akun admin yang dibuat/diperbarui oleh `npm run seed`
ADMIN_USERNAME=PGADMIN
ADMIN_PASSWORD=
ADMIN_NAMA=Administrator WARES
ADMIN_EMAIL=
